# Clé API TypeSafe / Jev : https://typesafe.ai (obligatoire si DECISION_BACKEND=jev)
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# jev = décision réelle via TypeSafe. heuristic = test sans clé Jev.
DECISION_BACKEND=jev

# Portefeuille virtuel
PAPER_CASH=1000
STAKE_USD=15
MAX_BANKROLL_FRACTION=0.1

# Filtres d'entrée
MIN_CONFIDENCE=0.58
MIN_EDGE=0.02
MIN_TRADEABLE=0
MIN_SECONDS_LEFT=25
MAX_SECONDS_LEFT=120
MAX_SPREAD=0.08
MIN_ASK=0.08
MAX_ASK=0.92

POLL_SECONDS=8

# Si Gamma/CLOB sont bloqués (souvent le cas en France / ANJ), un proxy HTTPS :
# HTTPS_PROXY=http://127.0.0.1:7890

# false uniquement si un proxy casse les certificats SSL
POLYMARKET_SSL_VERIFY=true
